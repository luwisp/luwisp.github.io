---
import {
  Archive,
  ArrowDown,
  ArrowLeft,
  ArrowRight,
  ArrowUp,
  BookOpen,
  ChevronDown,
  ChevronRight,
  Clover,
  Clock3,
  FileText,
  ExternalLink,
  Folder,
  FolderOpen,
  Github,
  Grid2X2,
  HardDrive,
  Home,
  Info,
  List,
  Mail,
  Menu,
  MoonStar,
  Palette,
  PanelLeft,
  PanelRight,
  RotateCw,
  Search,
  Sparkles,
  Sun,
  UserRound,
  X
} from "lucide-astro";

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
}

const { name, size = 19, strokeWidth = 1.8 } = Astro.props;
const iconMap = {
  archive: Archive,
  down: ArrowDown,
  back: ArrowLeft,
  forward: ArrowRight,
  up: ArrowUp,
  "book-open": BookOpen,
  chevron: ChevronDown,
  "chevron-right": ChevronRight,
  clover: Clover,
  clock: Clock3,
  external: ExternalLink,
  file: FileText,
  folder: Folder,
  "folder-open": FolderOpen,
  github: Github,
  grid: Grid2X2,
  drive: HardDrive,
  home: Home,
  info: Info,
  list: List,
  mail: Mail,
  menu: Menu,
  moon: MoonStar,
  palette: Palette,
  panel: PanelLeft,
  details: PanelRight,
  refresh: RotateCw,
  search: Search,
  sparkles: Sparkles,
  sun: Sun,
  user: UserRound,
  x: X
};
const IconComponent = iconMap[name as keyof typeof iconMap] ?? ExternalLink;
---

<IconComponent size={size} stroke-width={strokeWidth} aria-hidden="true" />
