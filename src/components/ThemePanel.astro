---
import type { ThemeDefinition } from "../lib/themes";

interface Props {
  themes: ThemeDefinition[];
  defaultLight: string;
  defaultDark: string;
}

const { themes, defaultLight, defaultDark } = Astro.props;
const groupedThemes = {
  light: themes.filter((theme) => theme.type === "light"),
  dark: themes.filter((theme) => theme.type === "dark")
};
---

  <div class="theme-groups">
    {(["light", "dark"] as const).map((mode) => (
      <section class="theme-group" aria-labelledby={`theme-${mode}`}>
        <h3 id={`theme-${mode}`}>{mode === "light" ? "亮色主题" : "暗色主题"}</h3>
        <div class="theme-options">
          {groupedThemes[mode].map((theme) => (
            <button
              class:list={[
                "theme-option",
                {
                  "is-selected": theme.id === (mode === "light" ? defaultLight : defaultDark),
                  "theme-option--pencil": theme.appearance?.texture === "colored-pencil"
                }
              ]}
              type="button"
              aria-pressed={theme.id === (mode === "light" ? defaultLight : defaultDark)}
              data-theme-option
              data-theme-id={theme.id}
              data-theme-mode={theme.type}
            >
              <span class="theme-option__colors" aria-hidden="true">
                {theme.swatches.slice(0, 3).map((color) => <i style={`--swatch:${color}`}></i>)}
              </span>
              <span class="theme-option__copy">
                <strong>{theme.name}</strong>
                <small>{theme.family}</small>
              </span>
            </button>
          ))}
        </div>
      </section>
    ))}
  </div>
