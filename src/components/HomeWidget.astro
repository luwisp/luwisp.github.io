---
import siteData from "../../content/site.json";
import type { WidgetId } from "../config/widgets";
import { widgetPlacementStyle } from "../config/widgets";
import { getPostCategory, getPostHref, type PostEntry } from "../lib/content";
import { publicAsset } from "../lib/paths";
import type { getBlogStats } from "../lib/stats";
import ContributionGrid from "./ContributionGrid.astro";
import Icon from "./Icon.astro";

interface Props {
  id: WidgetId;
  recentPosts: PostEntry[];
  stats: ReturnType<typeof getBlogStats>;
}

const { id, recentPosts, stats } = Astro.props;
const profile = siteData.profile;
const avatar = publicAsset(profile.avatar);
const compactDate = new Intl.DateTimeFormat("zh-CN", { month: "2-digit", day: "2-digit" });
const latestDate = stats.latestDate
  ? new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "short" }).format(stats.latestDate)
  : "暂无";
const formattedWords = new Intl.NumberFormat("zh-CN", {
  notation: "compact",
  maximumFractionDigits: 1
}).format(stats.totalWords);
const desktopLink = id === "github"
  ? profile.links.find((link) => link.icon === "github")
  : id === "email"
    ? profile.links.find((link) => link.icon === "mail")
    : undefined;
const placementStyle = widgetPlacementStyle(id);
---

{id === "clock" && (
  <section class="desktop-widget widget-clock" aria-label="当前时间" style={placementStyle} data-home-object={id}>
    <div class="widget-clock__header">
      <span class="clock-date" data-clock-date>正在读取日期</span>
      <Icon name="clock" size={16} />
    </div>
    <time class="large-clock" data-clock data-clock-format="adaptive">--:--:--</time>
    <span class="clock-zone">上海</span>
  </section>
)}

{id === "user" && (
  <section class="desktop-widget widget-user" aria-labelledby="profile-title" style={placementStyle} data-home-object={id}>
    <div class="widget-user__copy">
      <p>欢迎回来</p>
      <h1 id="profile-title">{profile.name}</h1>
      <span>{profile.bio}</span>
    </div>
    <span class="widget-user__status"><i aria-hidden="true"></i>在线</span>
  </section>
)}

{id === "avatar" && (
  <section class="desktop-app desktop-app--avatar" aria-label={profile.displayName} style={placementStyle} data-home-object={id}>
    <span class="desktop-app__icon desktop-app__icon--avatar">
      <img src={avatar} alt="" width="420" height="420" />
    </span>
    <span class="desktop-app__label">{profile.name}</span>
  </section>
)}

{id === "theme" && (
  <button
    class="desktop-app"
    type="button"
    aria-label="切换明暗主题"
    style={placementStyle}
    data-theme-toggle
    data-home-object={id}
  >
    <span class="desktop-app__icon desktop-app__icon--theme" data-current-swatch>
      <span class="desktop-app__theme-symbol" aria-hidden="true">
        <Icon name="sun" size={27} />
        <Icon name="moon" size={27} />
      </span>
    </span>
    <span class="desktop-app__label">明暗模式</span>
  </button>
)}

{id === "appearance" && (
  <button
    class="desktop-app"
    type="button"
    aria-label="打开主题与外观设置"
    style={placementStyle}
    data-theme-dialog-open
    data-home-object={id}
  >
    <span class="desktop-app__icon desktop-app__icon--appearance">
      <Icon name="palette" size={28} />
      <span class="appearance-swatches" aria-hidden="true"><i></i><i></i><i></i></span>
    </span>
    <span class="desktop-app__label">外观</span>
  </button>
)}

{id === "recent" && (
  <section class="desktop-widget widget-recent" aria-labelledby="recent-title" style={placementStyle} data-home-object={id}>
    <header class="widget-header">
      <div>
        <h2 id="recent-title">最近文章</h2>
        <p>{recentPosts.length} 篇最近更新</p>
      </div>
      <a href="/archive/" aria-label="打开全部归档" data-internal-link data-app-order="1">
        <Icon name="archive" size={17} />
      </a>
    </header>
    <div class="recent-file-list">
      {recentPosts.map((post) => (
        <a class="recent-file" href={getPostHref(post)} data-internal-link data-app-order="3">
          <span class="recent-file__icon"><Icon name="file" size={17} /></span>
          <span class="recent-file__copy">
            <strong>{post.data.title}</strong>
            <small>{getPostCategory(post)}</small>
          </span>
          <time datetime={post.data.date.toISOString()}>{compactDate.format(post.data.date)}</time>
        </a>
      ))}
    </div>
  </section>
)}

{id === "contributions" && <ContributionGrid placementStyle={placementStyle} />}

{id === "stats" && (
  <section class="desktop-widget widget-stats" aria-labelledby="stats-title" style={placementStyle} data-home-object={id}>
    <header class="widget-header widget-header--compact">
      <div><h2 id="stats-title">博客信息</h2></div>
      <Icon name="info" size={17} />
    </header>
    <dl class="stats-grid">
      <div><dt>文章</dt><dd>{stats.postCount}</dd></div>
      <div><dt>分类</dt><dd>{stats.categoryCount}</dd></div>
      <div><dt>字数</dt><dd>{formattedWords}</dd></div>
      <div><dt>更新</dt><dd>{latestDate}</dd></div>
    </dl>
  </section>
)}

{desktopLink && (
  <a
    class:list={["desktop-app", `desktop-app--${id}`]}
    href={desktopLink.url}
    target={desktopLink.url.startsWith("http") ? "_blank" : undefined}
    rel="noreferrer"
    aria-label={desktopLink.label}
    style={placementStyle}
    data-home-object={id}
  >
    <span class:list={["desktop-app__icon", `desktop-app__icon--${id}`]}>
      <Icon name={desktopLink.icon} size={30} />
    </span>
    <span class="desktop-app__label">{desktopLink.label}</span>
  </a>
)}
