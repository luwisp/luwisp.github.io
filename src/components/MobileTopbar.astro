---
import Icon from "./Icon.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="mobile-topbar">
  <div class="mobile-topbar__left">
    <button
      class="icon-control mobile-menu-button"
      type="button"
      aria-label="展开导航"
      aria-expanded="false"
      data-menu-toggle
    >
      <span class="menu-icon menu-icon--open"><Icon name="menu" /></span>
      <span class="menu-icon menu-icon--close"><Icon name="x" /></span>
    </button>
    <a class="mobile-brand" href="/" data-internal-link>{title}</a>
  </div>
  <time class="mobile-clock" data-clock data-clock-format="short">--:--</time>
</header>
