---
import contributions from "../data/contributions.json";
import siteData from "../../content/site.json";

interface Props {
  placementStyle?: string;
}

interface ContributionDay {
  date: string;
  contributionCount: number;
  contributionLevel: string;
  color: string;
  weekday: number;
}

interface ContributionWeek {
  firstDay: string;
  contributionDays: ContributionDay[];
}

const levelMap: Record<string, number> = {
  NONE: 0,
  FIRST_QUARTILE: 1,
  SECOND_QUARTILE: 2,
  THIRD_QUARTILE: 3,
  FOURTH_QUARTILE: 4
};
const weeks = contributions.weeks as ContributionWeek[];
const days = weeks.flatMap((week) => week.contributionDays);
const calendarWeeks = weeks.map((week) => ({
  firstDay: week.firstDay,
  days: Array.from(
    { length: 7 },
    (_, weekday) => week.contributionDays.find((day) => day.weekday === weekday) ?? null
  )
}));
const githubUser = siteData.profile.githubUser;
const snapshotMatchesProfile = contributions.username.toLowerCase() === githubUser.toLowerCase();
const hasContributionData = contributions.status === "ready" && days.length > 0 && snapshotMatchesProfile;
const { placementStyle } = Astro.props;
---

<section class="desktop-widget widget-contributions" aria-labelledby="contribution-title" style={placementStyle} data-home-object="contributions">
  <header class="widget-header">
    <div>
      <h2 id="contribution-title">最近提交</h2>
      {hasContributionData && <p>过去一年 {contributions.totalContributions} 次公开贡献</p>}
    </div>
    <a href={`https://github.com/${githubUser}`} target="_blank" rel="noreferrer">
      @{githubUser}
    </a>
  </header>

  {hasContributionData ? (
    <>
      <div
        class="contribution-grid"
        aria-label={`过去一年的 ${contributions.totalContributions} 次贡献`}
        style={`--contribution-week-count:${calendarWeeks.length}`}
      >
        {calendarWeeks.map((week) => (
          <span class="contribution-week" data-first-day={week.firstDay}>
            {week.days.map((day) => day ? (
              <span
                class="contribution-day"
                data-level={levelMap[day.contributionLevel] ?? 0}
                title={`${day.date}: ${day.contributionCount}`}
              ></span>
            ) : (
              <span class="contribution-day contribution-day--placeholder" aria-hidden="true"></span>
            ))}
          </span>
        ))}
      </div>
    </>
  ) : (
    <div class="contribution-empty">
      <p>尚未同步 GitHub 活动。</p>
    </div>
  )}
</section>
