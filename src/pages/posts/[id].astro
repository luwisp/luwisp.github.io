---
import { render } from "astro:content";
import Icon from "../../components/Icon.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, type PostEntry } from "../../lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const date = new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "long", day: "numeric" }).format(post.data.date);
---

<BaseLayout activePage="post" title={post.data.title} description={post.data.summary}>
  <div class="article-layout">
    <button class="article-back" type="button" data-history-back>
      <Icon name="back" size={18} />
      <span>返回</span>
    </button>
    <TableOfContents headings={headings} />
    <article class="article-card">
      <header class="article-header">
        <p class="article-category">{post.data.category}</p>
        <h1 tabindex="-1" data-page-title>{post.data.title}</h1>
        <div class="article-meta">
          <time datetime={post.data.date.toISOString()}>{date}</time>
          {post.data.minutes && <span>{post.data.minutes} 分钟阅读</span>}
          {post.data.tags.map((tag) => <span class="article-tag">{tag}</span>)}
        </div>
      </header>
      <div class="markdown-body">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
