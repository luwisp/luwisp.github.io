---
import { render } from "astro:content";
import Icon from "../../components/Icon.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPostCategory, getPosts, type PostEntry } from "../../lib/content";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const category = getPostCategory(post);
const date = new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "long", day: "numeric" }).format(post.data.date);
---

<BaseLayout activePage="post" title={post.data.title} description={post.data.summary}>
  <div class="article-layout">
    <TableOfContents headings={headings} />
    <article class="article-card">
      <nav class="article-mobile-nav" aria-label="文章导航">
        <a
          href={withBase("/archive/")}
          aria-label="返回文章列表"
          title="返回文章列表"
          data-mobile-reader-back
          data-internal-link
        >
          <Icon name="back" size={20} />
        </a>
      </nav>
      <header class="article-header">
        <p class="article-category">{category}</p>
        <h1 tabindex="-1" data-page-title>{post.data.title}</h1>
        <div class="article-meta">
          <time datetime={post.data.date.toISOString()}>{date}</time>
          {post.data.minutes && <span>{post.data.minutes} 分钟阅读</span>}
          {post.data.tags.map((tag) => <span class="article-tag">{tag}</span>)}
        </div>
      </header>
      <div class="markdown-body">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>
