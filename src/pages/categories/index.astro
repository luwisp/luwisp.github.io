---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getPosts } from "../../lib/content";
import { getFileManagerData, type MusicConfig, type MusicSnapshot } from "../../lib/file-manager";
import musicConfig from "../../../content/music.json";
import musicData from "../../data/music.json";

const posts = await getPosts();
const { volumes, entries } = getFileManagerData(posts, musicData as MusicSnapshot, musicConfig as MusicConfig);
const defaultVolume = volumes.find((volume) => volume.id === "files") ?? volumes[0];
const defaultEntries = entries
  .filter((entry) => entry.volume === defaultVolume.id && entry.parentPath === "")
  .sort((left, right) => left.displayName.localeCompare(right.displayName, "zh-CN"));
---

<BaseLayout activePage="categories" title="文件" description="按内容卷浏览文章与音乐">
  <section
    class="file-manager is-card-view"
    data-file-manager
    data-default-volume={defaultVolume.id}
    aria-label="内容文件管理器"
  >
    <header class="file-manager__toolbar">
      <div class="file-manager__history" aria-label="目录导航">
        <button type="button" data-file-back aria-label="后退" title="后退" disabled>
          <Icon name="back" size={18} />
        </button>
        <button type="button" data-file-forward aria-label="前进" title="前进" disabled>
          <Icon name="forward" size={18} />
        </button>
        <button type="button" data-file-up aria-label="上一级" title="上一级" disabled>
          <Icon name="up" size={18} />
        </button>
        <button type="button" data-file-refresh aria-label="刷新" title="刷新">
          <Icon name="refresh" size={17} />
        </button>
      </div>

      <nav class="file-manager__breadcrumbs" data-file-breadcrumbs aria-label="当前位置">
        <div class="file-manager__volume-picker" data-file-volume-picker>
          <button
            type="button"
            class="file-manager__volume-trigger"
            data-file-volume-trigger
            aria-label="切换内容卷"
            title="切换内容卷"
            aria-haspopup="menu"
            aria-expanded="false"
          >
            <Icon name="drive" size={15} strokeWidth={1.55} />
            <Icon name="chevron" size={10} strokeWidth={2} />
          </button>
          <div class="file-manager__volume-menu" data-file-volume-menu role="menu" hidden>
            {volumes.map((volume) => (
              <button
                type="button"
                role="menuitem"
                data-file-volume={volume.id}
                data-volume-name={volume.name}
                data-volume-description={volume.description}
                data-volume-location={volume.location}
                data-volume-item-count={volume.itemCount}
                data-volume-content-count={volume.contentCount}
                data-volume-content-label={volume.contentLabel}
                data-volume-size={volume.sizeBytes}
                data-volume-modified={volume.modifiedAt}
              >
                {volume.name}
              </button>
            ))}
          </div>
        </div>
        <button type="button" class="file-manager__volume-name" data-file-path="" data-file-volume-name aria-current="page">
          {defaultVolume.name}
        </button>
        <div class="file-manager__breadcrumb-trail" data-file-breadcrumb-trail></div>
      </nav>

      <label class="file-manager__search">
        <Icon name="search" size={17} />
        <input type="search" data-file-search placeholder="搜索内容" autocomplete="off" />
        <kbd>Ctrl K</kbd>
      </label>
    </header>

    <div class="file-manager__commandbar">
      <label class="file-manager__sort">
        <span>排序</span>
        <select data-file-sort aria-label="排序方式">
          <option value="name">名称</option>
          <option value="date">修改日期</option>
          <option value="type">类型</option>
          <option value="size">大小</option>
        </select>
      </label>
      <button type="button" class="file-manager__sort-direction" data-file-sort-direction aria-label="当前升序，切换为降序" title="切换排序方向" aria-pressed="false">
        <Icon name="down" size={17} />
      </button>
      <div class="file-manager__view-switch" role="group" aria-label="查看方式">
        <button type="button" data-file-view="grid" aria-label="网格视图" title="网格视图" aria-pressed="false">
          <Icon name="grid" size={17} />
        </button>
        <button type="button" data-file-view="card" class="is-active" aria-label="卡片视图" title="卡片视图" aria-pressed="true">
          <Icon name="cards" size={18} />
        </button>
        <button type="button" data-file-view="list" aria-label="列表视图" title="列表视图" aria-pressed="false">
          <Icon name="list" size={18} />
        </button>
      </div>
      <button type="button" class="file-manager__details-toggle is-active" data-file-details-toggle aria-label="显示或隐藏详情" title="详情" aria-pressed="true">
        <Icon name="details" size={18} />
      </button>
    </div>

    <div class="file-manager__workspace">
      <div class="file-manager__browser">
        <div class="file-manager__columns" aria-hidden="true">
          <span>名称</span>
          <span>类型</span>
          <span>修改日期</span>
        </div>
        <div class="file-manager__entries" data-file-entries role="listbox" aria-label="文件与文件夹" tabindex="0">
          {entries.map((entry) => (
            <button
              type="button"
              class="file-manager__entry"
              data-file-entry
              data-entry-volume={entry.volume}
              data-entry-type={entry.type}
              data-entry-kind={entry.kind}
              data-entry-icon={entry.icon}
              data-entry-type-label={entry.typeLabel}
              data-entry-location={entry.location}
              data-entry-external={entry.external ? "true" : "false"}
              data-entry-artist={entry.artist}
              data-entry-album={entry.album}
              data-entry-duration={entry.durationMs}
              data-entry-cover={entry.coverUrl}
              data-entry-path={entry.path}
              data-entry-parent={entry.parentPath}
              data-entry-name={entry.name}
              data-entry-display-name={entry.displayName}
              data-entry-description={entry.description}
              data-entry-modified={entry.modifiedAt}
              data-entry-time={entry.modifiedTime}
              data-entry-size={entry.sizeBytes}
              data-entry-count={entry.itemCount}
              data-entry-href={entry.href}
              data-entry-category={entry.category}
              data-entry-tags={entry.tags.join(",")}
              data-entry-minutes={entry.minutes}
              data-entry-search={`${entry.displayName} ${entry.name} ${entry.path} ${entry.category ?? ""} ${entry.artist ?? ""} ${entry.album ?? ""} ${entry.tags.join(" ")} ${entry.description}`.toLocaleLowerCase("zh-CN")}
              role="option"
              aria-selected="false"
              tabindex="-1"
              hidden={entry.volume !== defaultVolume.id || entry.parentPath !== ""}
            >
              <span class="file-manager__entry-visual">
                <span class:list={["file-manager__entry-icon", { "is-folder": entry.type === "folder", "is-music": entry.kind === "track" }]}>
                  <Icon name={entry.type === "folder" ? "folder" : entry.icon} size={entry.type === "folder" ? 34 : 31} strokeWidth={1.55} />
                </span>
                {entry.coverUrl && (
                  <img class="file-manager__entry-cover" src={entry.coverUrl} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                )}
              </span>
              <span class="file-manager__entry-copy">
                <strong>{entry.displayName}</strong>
                <span class="file-manager__entry-description">{entry.description}</span>
                <small>{entry.type === "folder" ? `${entry.itemCount} 个项目` : entry.kind === "track" ? entry.artist || "歌曲" : entry.name}</small>
              </span>
              <span class="file-manager__entry-type">{entry.typeLabel}</span>
              <time datetime={entry.modifiedAt}>{entry.modifiedAt.slice(0, 10)}</time>
              <span class="file-manager__entry-path">{entry.parentPath || volumes.find((volume) => volume.id === entry.volume)?.name || entry.volume}</span>
            </button>
          ))}
        </div>
        <div class="file-manager__empty" data-file-empty hidden>
          <Icon name="search" size={24} />
          <strong>没有找到文件</strong>
          <span>尝试更换关键词或返回其他目录。</span>
        </div>
      </div>

      <aside class="file-manager__details" data-file-details aria-label="项目详情">
        <div class="file-manager__details-hero">
          <span class="file-manager__details-visual">
            <span data-file-details-icon class="is-volume"><Icon name="drive" size={34} strokeWidth={1.5} /></span>
            <img data-file-details-cover alt="" decoding="async" referrerpolicy="no-referrer" hidden />
          </span>
          <div>
            <h1 data-file-details-title>{defaultVolume.name}</h1>
            <p data-file-details-name>内容卷</p>
          </div>
        </div>
        <p class="file-manager__details-description" data-file-details-description>{defaultVolume.description}</p>
        <dl>
          <div><dt>类型</dt><dd data-file-details-type>内容卷</dd></div>
          <div><dt>位置</dt><dd data-file-details-location>{defaultVolume.location}</dd></div>
          <div><dt>项目</dt><dd data-file-details-count>{defaultVolume.itemCount} 个项目</dd></div>
          <div><dt data-file-details-meta-label>{defaultVolume.contentLabel}</dt><dd data-file-details-posts>{defaultVolume.contentCount} {defaultVolume.contentLabel === "文章" ? "篇" : "首"}</dd></div>
          <div data-file-details-size-row><dt>大小</dt><dd data-file-details-size>--</dd></div>
          <div data-file-details-date-row hidden><dt>修改日期</dt><dd data-file-details-date></dd></div>
          <div data-file-details-read-row hidden><dt>阅读时间</dt><dd data-file-details-read></dd></div>
          <div data-file-details-artist-row hidden><dt>歌手</dt><dd data-file-details-artist></dd></div>
          <div data-file-details-album-row hidden><dt>专辑</dt><dd data-file-details-album></dd></div>
          <div data-file-details-duration-row hidden><dt>时长</dt><dd data-file-details-duration></dd></div>
        </dl>
        <div class="file-manager__details-tags" data-file-details-tags hidden></div>
      </aside>
    </div>

    <footer class="file-manager__statusbar">
      <span data-file-status>{defaultEntries.length} 个项目</span>
      <span data-file-selection>未选择项目</span>
    </footer>
  </section>
</BaseLayout>
