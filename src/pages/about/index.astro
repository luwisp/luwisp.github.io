---
import about from "../../../content/about.json";
import siteData from "../../../content/site.json";
import Icon from "../../components/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publicAsset } from "../../lib/paths";

const profile = siteData.profile;
const avatar = publicAsset(profile.avatar);
const email = profile.links.find((link) => link.icon === "mail")?.url;
const github = profile.links.find((link) => link.icon === "github")?.url;
const emailHref = email ? (email.startsWith("mailto:") ? email : `mailto:${email}`) : undefined;
const orcidId = about.orcid.split("/").at(-1);
---

<BaseLayout activePage="about" title="About Xufeng Chen" description="Xufeng Chen (luwisp) — undergraduate at Nanjing University, focusing on machine learning and software systems.">
  <article class="about-page" aria-labelledby="about-title">
    <p class="about-page__eyebrow">ABOUT ME</p>
    <header class="about-profile">
      <img class="about-profile__avatar" src={avatar} alt={`${about.fullName}'s avatar`} width="112" height="112" />
      <div class="about-profile__identity">
        <h1 id="about-title" data-page-title tabindex="-1">{about.fullName}</h1>
        <p class="about-profile__full-name"><span lang="zh-CN">{about.nativeName}</span><span aria-hidden="true">·</span><span>@{about.handle}</span></p>
        <p class="about-profile__affiliation">{about.role}</p>
        <p class="about-profile__affiliation">{about.affiliation}</p>
      </div>
    </header>

    <section class="about-section" aria-labelledby="about-introduction-heading">
      <h2 id="about-introduction-heading">Introduction</h2>
      <p class="about-section__intro">{about.introduction}</p>
    </section>

    <section class="about-section" aria-labelledby="about-contact-heading">
      <h2 id="about-contact-heading">Contact</h2>
      <dl class="about-contact">
        {email && (
          <div>
            <dt><Icon name="mail" size={16} /> Email</dt>
            <dd><a href={emailHref}>{email.replace(/^mailto:/, "")}</a></dd>
          </div>
        )}
        <div>
          <dt><span class="about-contact__orcid-icon" aria-hidden="true">iD</span> ORCID</dt>
          <dd><a href={about.orcid} target="_blank" rel="noopener noreferrer" aria-label={`ORCID iD ${orcidId}`}>{orcidId}</a></dd>
        </div>
        {github && (
          <div>
            <dt><Icon name="github" size={16} /> GitHub</dt>
            <dd><a href={github} target="_blank" rel="noopener noreferrer">{github.replace(/^https?:\/\//, "")}</a></dd>
          </div>
        )}
      </dl>
    </section>

  </article>
</BaseLayout>
