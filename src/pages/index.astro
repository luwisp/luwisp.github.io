---
import HomeWidget from "../components/HomeWidget.astro";
import { uiConfig } from "../config/site";
import { homeWidgets } from "../config/widgets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPosts } from "../lib/content";
import { getBlogStats } from "../lib/stats";

const posts = await getPosts();
const recentPosts = posts.slice(0, uiConfig.recentPostCount);
const stats = getBlogStats(posts);
const mobilePages = [...new Set(homeWidgets.map((widget) => widget.mobilePage))]
  .sort((left, right) => left - right)
  .map((page) => homeWidgets.filter((widget) => widget.mobilePage === page));
---

<BaseLayout activePage="home">
  <div class="home-workspace" aria-label="博客桌面">
    <div class="home-pager" data-home-pager>
      {mobilePages.map((widgets, pageIndex) => (
        <section class="home-page" aria-label={`桌面第${pageIndex + 1}页`} data-home-page>
          {widgets.map((widget) => (
            <HomeWidget id={widget.id} recentPosts={recentPosts} stats={stats} />
          ))}
        </section>
      ))}
    </div>

    {mobilePages.length > 1 && (
      <nav class="home-page-indicator" aria-label="桌面分页">
        {mobilePages.map((_, pageIndex) => (
          <button
            class:list={{ "is-active": pageIndex === 0 }}
            type="button"
            aria-label={`转到第${pageIndex + 1}页`}
            aria-current={pageIndex === 0 ? "page" : undefined}
            data-home-page-target={pageIndex}
          ></button>
        ))}
      </nav>
    )}
  </div>
</BaseLayout>
