---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import siteData from "../../content/site.json";
import AppDock from "../components/AppDock.astro";
import Icon from "../components/Icon.astro";
import ThemePanel from "../components/ThemePanel.astro";
import { getAppOrder, type AppId } from "../config/apps";
import { uiConfig } from "../config/site";
import { getCategories, getPosts } from "../lib/content";
import { publicAsset } from "../lib/paths";
import { themeDefaults, themes } from "../lib/themes";

interface Props {
  title?: string;
  description?: string;
  activePage: "home" | "archive" | "categories" | "post";
}

const { title, description = siteData.site.subtitle, activePage } = Astro.props;
const posts = await getPosts();
const categories = getCategories(posts);
const pageTitle = title ? `${title} · ${siteData.site.title}` : siteData.site.title;
const wallpaper = publicAsset(siteData.site.wallpaper);
const initialThemePayload = JSON.stringify({ themes, defaults: themeDefaults });
const activeApp = (activePage === "post" ? "reader" : activePage) as AppId;
const appOrder = getAppOrder(Astro.url.pathname);
const readerTitle = activePage === "post" ? title : undefined;
const readerHref = activePage === "post" ? Astro.url.pathname : undefined;
const appCloseLabel = activePage === "post"
  ? "关闭阅读器"
  : activePage === "archive"
    ? "关闭归档"
    : "关闭分类";
---

<!doctype html>
<html
  lang="zh-CN"
  data-theme-mode="dark"
  style={`--page-transition-duration:${uiConfig.pageTransition.durationMs}ms`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1e2326" />
    <title>{pageTitle}</title>
    {uiConfig.pageTransition.enabled && <ClientRouter fallback="swap" />}
    <script is:inline define:vars={{ initialThemePayload }}>
      (() => {
        try {
          const payload = JSON.parse(initialThemePayload);
          const saved = JSON.parse(localStorage.getItem("luorong.notes.theme") || "{}");
          const mode = saved.mode || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          const selectedId = saved[mode] || payload.defaults[mode];
          const theme = payload.themes.find((item) => item.id === selectedId) || payload.themes.find((item) => item.type === mode);
          if (!theme) return;
          document.documentElement.dataset.themeMode = mode;
          document.documentElement.dataset.theme = theme.id;
          Object.entries(theme.tokens).forEach(([key, value]) => {
            if (key === "colorScheme") document.documentElement.style.colorScheme = value;
            else document.documentElement.style.setProperty(key, value);
          });
        } catch {}

      })();
    </script>
  </head>
  <body
    style={`--wallpaper-image:url("${wallpaper}")`}
    data-active-page={activePage}
    data-active-app={activeApp}
    data-app-order={appOrder}
    data-reader-title={readerTitle}
    data-reader-href={readerHref}
    data-clock-zone={siteData.profile.location}
  >
    <div class="wallpaper" aria-hidden="true"></div>
    <AppDock
      activeApp={activeApp}
      postCount={posts.length}
      categoryCount={categories.length}
      readerTitle={readerTitle}
      readerHref={readerHref}
    />
    <main class="main-panel" id="main-content" data-main-panel>
      <section
        class:list={["app-screen", `app-screen--${activePage}`, { "app-screen--window": activePage !== "home" }]}
        data-app-screen
      >
        {activePage !== "home" && (
          <header class="app-window__bar">
            <a
              class="app-window__close"
              href="/"
              aria-label={appCloseLabel}
              data-internal-link
              data-reader-close={activePage === "post" ? "true" : undefined}
            >
              <Icon name="x" size={13} strokeWidth={2.2} />
            </a>
            <time class="app-window__clock" data-clock data-clock-format="short">--:--</time>
          </header>
        )}
        <div class:list={["app-content", { "app-content--home": activePage === "home" }]} data-app-content>
          <div class:list={["page-frame", { "page-frame--home": activePage === "home" }]}>
            <slot />
          </div>
        </div>
      </section>
    </main>
    <ThemePanel themes={themes} defaultLight={themeDefaults.light} defaultDark={themeDefaults.dark} />
    <script>
      import "../scripts/ui";
    </script>
  </body>
</html>
