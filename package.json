{
  "name": "luorong-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "sync-github": "node scripts/fetch-github-contributions.mjs",
    "sync-music": "node scripts/fetch-netease-playlists.mjs",
    "sync-data": "npm run sync-github && npm run sync-music",
    "build": "npm run sync-data && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:site": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "astro": "7.0.9",
    "katex": "latest",
    "lucide-astro": "latest",
    "rehype-katex": "latest",
    "remark-math": "latest"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "latest"
  }
}
